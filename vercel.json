{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": ["fra1"],
  "fluid": true,
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "17 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/chat/stream/route.ts": {
      "maxDuration": 120,
      "supportsCancellation": true,
      "regions": ["fra1"]
    }
  }
}
