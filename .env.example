# Application
APP_ENV=local
DEPLOYMENT_MODE=local
DEPLOYMENT_PROFILE=demo
DEFAULT_LOCALE=de
CATALOGUE_DRIVER=fixture
CATALOGUE_ADMIN_EMAILS=info@conformisgrc.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
ANONYMOUS_UPLOAD_RETENTION_HOURS=24
PARSED_CONTENT_IDLE_RETENTION_DAYS=7
PARSED_CONTENT_MAX_RETENTION_DAYS=30

# Neon Auth (providers and transactional auth e-mail are configured in Neon Console)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# PostgreSQL
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Hosted storage: create a private Vercel Blob store in Frankfurt (fra1).
STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=
# Optional local/self-hosted S3-compatible fallback
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=conformis-local
S3_ACCESS_KEY_ID=conformis
S3_SECRET_ACCESS_KEY=conformis-local-only

# AI providers — all operator modes are optional and disabled by default
AI_PROVIDER_ALLOWLIST=openrouter,requesty,anthropic,google,openai
BYOK_PROVIDER_ALLOWLIST=openrouter,requesty,anthropic,google,openai
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EU_BASE_URL=https://eu.openrouter.ai/api/v1
# Direct routes remain absent until privacy qualification and an exact curated model
# list are configured. Requesty IDs must use EU-only upstream deployments. OpenAI
# keys must belong to an EU data-residency project approved for MAM or ZDR.
BYOK_REQUESTY_EU_ZDR_ENABLED=false
BYOK_REQUESTY_ANALYSIS_MODELS=
BYOK_OPENAI_EU_ZDR_ENABLED=false
BYOK_OPENAI_ANALYSIS_MODELS=
BYOK_REQUESTY_CHAT_MODELS=
BYOK_ANTHROPIC_CHAT_MODELS=
BYOK_GOOGLE_CHAT_MODELS=
BYOK_OPENAI_CHAT_MODELS=
OPENROUTER_CHAT_PROVIDER_ONLY=
REQUESTY_CHAT_BASE_URL=https://router.eu.requesty.ai/v1
ANTHROPIC_CHAT_BASE_URL=https://api.anthropic.com/v1
GOOGLE_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_CHAT_BASE_URL=https://eu.api.openai.com/v1
BYOK_CHAT_PRIVACY_PROFILE_ID=byok-session-v1
DEFAULT_ANALYSIS_MODEL_PROFILE=
EVALUATED_ANALYSIS_MODEL_ALLOWLIST=
DEFAULT_CHAT_MODEL_PROFILE=
PREPROCESSING_MODEL_PROFILE=google/gemini-3.7-flash@openrouter
MODEL_CATALOG_REFRESH_HOURS=6
# Disable live provider discovery only for deterministic tests or offline self-hosting.
MODEL_CATALOGUE_DISCOVERY_DISABLED=false

# Every analysis runs on the user's own temporary key. Zero data retention is
# requested from OpenRouter unless switched off explicitly; the privacy profile
# recorded with each run reflects the route that was actually used.
OPENROUTER_ZDR=true

# Temporary user-supplied provider keys
# Generate 32 random bytes and encode them as canonical base64. Never reuse the Auth cookie secret.
BYOK_ENCRYPTION_KEY=
BYOK_ENCRYPTION_KEY_VERSION=1
BYOK_CREDENTIAL_TTL_HOURS=24
BYOK_MAX_OUTPUT_TOKENS=4000
BYOK_CHAT_MAX_OUTPUT_TOKENS=2000

# Abuse protection
# Long random value used only to HMAC request-address signals. Never log the input.
ABUSE_HASH_SECRET=
TRUST_CLOUDFLARE_PROXY=false

# Managed Vercel Workflow and release identification
APP_BUILD_ID=
# Generated automatically by Vercel when a cron is configured; set a 32+ character
# value explicitly for local production checks.
CRON_SECRET=

# Web runtime connection pool. Keep at 1 for serverless Vercel functions; the
# provider-side pooled DATABASE_URL handles concurrency.
DATABASE_CLIENT_MAX=1

# Observability — never include policy or prompt content
SENTRY_DSN=
OTEL_SERVICE_NAME=regulatory-gap-analysis
