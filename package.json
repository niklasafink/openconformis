{
  "name": "conformis-gap-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1",
      "exceljs>unzipper": "0.12.5",
      "esbuild@<=0.24.2": "0.25.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed:catalogue": "node --env-file-if-exists=.env.local --import tsx scripts/seed-catalogue.ts",
    "sample:generate": "node --import tsx scripts/generate-sample-policy.ts",
    "worker:dev": "node --conditions=react-server --import tsx scripts/worker.ts",
    "worker:smoke": "node --conditions=react-server --import tsx scripts/smoke-ingestion.ts",
    "production:check": "node --import tsx scripts/check-production-config.ts",
    "license:inventory": "node --import tsx scripts/generate-license-inventory.ts",
    "audit:production": "pnpm audit --prod --audit-level high",
    "quality": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build",
    "release:check": "pnpm quality && pnpm test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@neondatabase/auth": "0.5.0-beta",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "lucide-react": "1.33.0",
    "mammoth": "1.12.1",
    "next": "16.3.2",
    "next-intl": "4.13.7",
    "pdfjs-dist": "6.2.108",
    "pg-boss": "12.27.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tsx": "4.20.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "docx": "9.7.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
